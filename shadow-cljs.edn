{:source-paths ["src" "examples" "test"]
 :dependencies [[reagent "2.0.1"]]
 ;; vendor-js holds local packages (the reveal highlight plugin source) that
 ;; must be bundled like node_modules — classpath JS would be run through
 ;; :advanced and have the Reveal API it calls renamed out from under it.
 :js-options {:js-package-dirs ["node_modules" "vendor-js"]}
 ;; Pinned rather than left to shadow's defaults: 8080 and 9630 are common
 ;; enough to be taken by something else on a dev machine, and shadow reports a
 ;; failed bind as a log warning and carries on — the dev server is then simply
 ;; absent while another service answers on the port, which reads as a green
 ;; page load serving someone else's app.
 :nrepl {:port 7899}
 :http {:port 9637}
 ;; 8086 serves the dev tree (the Reagent shells, hot-reloaded); 8087 serves
 ;; the prerendered site `bb build` writes, so the hive-cljs scenarios can drive
 ;; the artifact that ships and not only the shell.
 :dev-http {8086 "public"
            8087 "dist/site"}
 :builds
 {:e2e  {:target :node-script
         :output-to "target/e2e.js"
         :main plato.e2e/-main}
  :app  {:target :browser
         :output-dir "public/js"
         :asset-path "/js"
         :modules {:main {:init-fn plato.example.core/init}}
         :devtools {:watch-dir "public"}}
  :acme {:target :browser
         :output-dir "public/acme/js"
         :asset-path "/acme/js"
         :modules {:main {:init-fn plato.acme.core/init}}
         :devtools {:watch-dir "public"}}
  ;; plato.fit on its own, for pages that are not the Reagent shell. A static
  ;; export is plain Reveal HTML with no ClojureScript in it, so a slide that
  ;; declared {:overflow :shrink} had nothing to shrink it and nothing could ask
  ;; the page whether its slides fit. This is the SAME plato.fit the shell
  ;; loads, compiled on its own — one definition of "fits", two bundles.
  :fit  {:target :browser
         :output-dir "public/vendor/plato-fit"
         :asset-path "/vendor/plato-fit"
         :modules {:main {:entries [plato.fit]}}}
  ;; The scene island on its own, for a prerendered page. plato.scene-island is
  ;; the ONE live scene implementation — the Reagent shell mounts it through
  ;; plato.scene-view — and it carries no view library, so this bundle is the
  ;; player, the timeline and the SVG renderer and nothing else.
  :scene {:target :browser
          :output-dir "public/vendor/plato-scene"
          :asset-path "/vendor/plato-scene"
          :modules {:main {:entries [plato.scene-island]}}}
  ;; Reveal's highlight plugin over highlight.js core and the languages the
  ;; decks use, for a prerendered page. The shell registers the same
  ;; plato.highlight; plato.html/plugins names this script.
  :highlight {:target :browser
              :output-dir "public/vendor/plato-highlight"
              :asset-path "/vendor/plato-highlight"
              :modules {:main {:entries [plato.highlight]}}}}}
