{:tasks
 {:requires ([babashka.fs :as fs]
             [babashka.process :refer [shell]])
  :init
  (defn build!
    "Run the `build` namespace (scripts/build.clj) on the native binary when it
     is installed, else on the JVM. Same namespace, same plato.html; the two
     runtimes emit the same bytes, which is what lets CI (JVM) and a laptop
     (cljw) publish the same site."
    [& args]
    (if (fs/which "cljw")
      (apply shell "cljw" "-cp" "src:examples:resources:scripts" "-m" "build" args)
      (apply shell "clojure" "-M:dev" "-m" "build" args)))

  assets  {:doc "Vendor the reveal.js dist into public/vendor"
           :task (build! "assets")}
  bundles {:doc "Release-build the scripts a prerendered page links: plato-fit, plato-scene, plato-highlight"
           :task (shell "npx shadow-cljs release fit scene highlight")}
  site    {:doc "Prerender the site decks and their assets into dist/site"
           :task (build! "site")}
  build   {:doc "assets, bundles, site — the tree GitHub Pages publishes"
           :depends [assets bundles site]}
  ;; Not `shell`: a task's name becomes a var in the tasks namespace, and that
  ;; one is already babashka.process/shell, referred above.
  shells  {:doc "Release-build the Reagent dev shells under public/ (browser suite only)"
           :task (shell "npx shadow-cljs release app acme")}

  ;; Installing. `brew install buddhilw/tap/plato` gets a PINNED tag and is what
  ;; someone authoring a deck elsewhere wants. These two install the code in
  ;; front of you: an edit to src/ changes the next `plato` run, no reinstall.
  cli       {:doc "Build the self-contained native CLI with ClojureWasm -> dist/plato"
             :task (shell "bash scripts/build-cli.sh")}
  install   {:doc "Install `plato` from THIS checkout into ~/.local/bin (pass --native for the binary)"
             :task (apply shell "bash" "scripts/install.sh" *command-line-args*)}
  uninstall {:doc "Remove the locally installed `plato` and its theme link"
             :task (shell "bash scripts/install.sh --uninstall")}}}
